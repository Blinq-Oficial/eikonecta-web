# Plantilla de variables de entorno — copia a .env y rellena los valores.
# Sincronizar con Netlify:  npx netlify env:import .env

# Contraseña del panel de administración (/admin/)
ADMIN_SECRET=

# Destino de los avisos de nuevos leads
LEAD_NOTIFICATION_EMAIL=contacto@eikonecta.com

# API key de Resend (pendiente)
# RESEND_API_KEY=

# NETLIFY_DATABASE_URL la inyecta Netlify automáticamente. No definirla a mano.
